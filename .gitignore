### Caches and logs
# Standard Cargo build directory
/target/
# Release staging
/dist/
# Python cache (module bytecode) - used in testing
__pycache__/
# Test fixture (shell.json) logs
/tests/apps/*/logs/
# Per-machine files for macOS test VMs
/scripts/dev/macvm.conf
# The pinned copy of the macOS 15.5 SDK
/.sdk

